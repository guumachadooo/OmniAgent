<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationId>hu.sbence.cavern.omniagent</ApplicationId>
    <ApplicationVersion>21</ApplicationVersion>
    <ApplicationDisplayVersion>2.1.0</ApplicationDisplayVersion>
    <ApplicationTitle>OmniAgent</ApplicationTitle>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <Authors>VoidX</Authors>
    <Description>Standalone One UI 9 Triad Command Hub &amp; Full-Agent Companion (Shared Cavernize Design Kit, Always-On Zero-Click Auto-Wake, Hardware-Backed Native Biometric Overlay, Local Debian File Explorer, Direct GitHub Push &amp; Cloudflare Hub v6).</Description>
    <!-- Intentionally pin targetSdkVersion=35 in AndroidManifest.xml while compiling against newer Android TFM -->
    <NoWarn>$(NoWarn);XA1006;XA4211</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <ItemGroup>
    <AndroidAsset Update="Assets\fonts\sf_pro_android_ui.ttf" Condition="Exists('Assets\fonts\sf_pro_android_ui.ttf')" />
  </ItemGroup>
</Project>
